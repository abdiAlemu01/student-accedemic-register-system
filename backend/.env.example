# ── Server Configuration ────────────────────
PORT=5000
NODE_ENV=development

# ── PostgreSQL (Local Development) ───────────
# Use these settings for local development with pgAdmin
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sarms_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# ── Production Database (Render/Cloud) ───────
# DATABASE_URL takes precedence over individual DB_* variables
# Set this in Render dashboard for production deployment
# DATABASE_URL=postgresql://user:password@host:5432/database

# ── JWT Authentication ───────────────────────
JWT_SECRET=replace_with_long_random_string_min_32_chars
JWT_EXPIRES_IN=7d

# ── CORS Configuration ───────────────────────
CLIENT_URL=http://localhost:5173
