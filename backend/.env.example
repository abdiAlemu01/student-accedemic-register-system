# ── Server ──────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── PostgreSQL ───────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sarms_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# ── JWT ──────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_min_32_chars
JWT_EXPIRES_IN=7d

# ── CORS ─────────────────────────────────────────────
CLIENT_URL=http://localhost:5173
